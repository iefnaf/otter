{
  "name": "otter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "otter": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/otter",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun test && bun run typecheck && bun run build && ./dist/otter --help"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.27",
    "typescript": "^5.9.3"
  }
}
